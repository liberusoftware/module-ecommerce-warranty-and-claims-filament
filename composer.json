{
  "name": "liberusoftware/module-ecommerce-warranty-and-claims-filament",
  "description": "Filament 5 adapter for the Ecommerce Warranty and Claims module.",
  "type": "library",
  "version": "0.1.0",
  "license": "MIT",
  "require": { "php": "^8.5", "filament/filament": "^5.0", "liberusoftware/module-ecommerce-warranty-and-claims": "^0.1" },
  "autoload": { "psr-4": { "Liberu\\EcommerceWarrantyAndClaimsFilament\\": "src/" } },
  "autoload-dev": { "psr-4": { "Liberu\\EcommerceWarrantyAndClaimsFilament\\Tests\\": "tests/" } },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "scripts": { "test": "phpunit" },
  "extra": { "laravel": { "providers": ["Liberu\\EcommerceWarrantyAndClaimsFilament\\Providers\\EcommerceWarrantyAndClaimsFilamentServiceProvider"] } },
  "minimum-stability": "dev",
  "prefer-stable": true
}
